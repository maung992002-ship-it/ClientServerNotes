{
  "compilerOptions": {
    "target": "ES6",
    "module": "nodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir":"dist",
    "forceConsistentCasingInFileNames": true,
    
    
  },
  "include": ["./src/**/*", "src/app.ts"]
}